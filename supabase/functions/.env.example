# Solo nombres y valores públicos/de ejemplo. No guardar credenciales reales en este archivo.
MP_ACCESS_TOKEN_TEST=TEST-REEMPLAZAR_EN_EDGE_FUNCTION_SECRETS
MP_WEBHOOK_SECRET_TEST=REEMPLAZAR_EN_EDGE_FUNCTION_SECRETS
STORE_BASE_URL=https://tienda-checkout-sandbox.acero-y-escamas.workers.dev
STORE_DEPLOYMENT_MODE=sandbox
# Exclusivo de sandbox: el nombre coincide con el depósito privado existente.
QUOTE_STORAGE_BUCKET=quote-reference-sandbox
# STORE_EXPECTED_SUPABASE_REF se deja vacío en sandbox; se requiere en producción.
STORE_EXPECTED_SUPABASE_REF=
# TURNSTILE_SECRET queda sin configurar mientras el widget gratuito esté pendiente.
# TURNSTILE_SECRET=CLAVE_PRIVADA_SOLO_EN_SUPABASE_SECRETS
# Orígenes adicionales separados por coma, por ejemplo una preview de Cloudflare.
STORE_ALLOWED_ORIGINS=
# Proveedor transaccional Resend. Configurar sólo en Edge Function Secrets del sandbox.
RESEND_API_KEY=REEMPLAZAR_EN_EDGE_FUNCTION_SECRETS
ORDER_EMAIL_FROM=Acero y Escamas <pedidos@sandbox.tu-dominio-verificado.example>
ORDER_NOTIFICATION_TO=ventas-sandbox@tu-dominio.example
# Secreto aleatorio distinto de todas las demás credenciales; autentica sólo el reintento programado.
ORDER_NOTIFICATION_DISPATCH_SECRET=REEMPLAZAR_EN_EDGE_FUNCTION_SECRETS
# Secreto independiente para la purga programada de datos personales vencidos.
ORDER_MAINTENANCE_SECRET=REEMPLAZAR_EN_EDGE_FUNCTION_SECRETS

# PRODUCCIÓN: NO configurar estas variables ni estos valores en el proyecto de pruebas.
# STORE_DEPLOYMENT_MODE=production
# STORE_EXPECTED_SUPABASE_REF=REF_DEL_PROYECTO_PRODUCTIVO
# QUOTE_STORAGE_BUCKET=quote-reference
# MP_ACCESS_TOKEN_LIVE=SECRETO_EN_SUPABASE_PRODUCCION
# MP_WEBHOOK_SECRET_LIVE=SECRETO_EN_SUPABASE_PRODUCCION
